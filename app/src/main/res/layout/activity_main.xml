<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <TextView
        android:id="@+id/ShopTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Shop"
        android:textSize="32sp"
        android:textStyle="bold"
        android:textColor="#1A1A1A"
        android:paddingStart="20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <GridLayout
        android:id="@+id/gridContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:columnCount="2"
        android:paddingTop="16dp"
        android:rowCount="2"
        android:layout_marginTop="24dp"
        android:alignmentMode="alignMargins"
        android:columnOrderPreserved="false"
        app:layout_constraintTop_toBottomOf="@id/ShopTextView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Car 1 -->
        <LinearLayout
            android:id="@+id/bmwF80"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:orientation="vertical"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:tag="bmwF80|car_bmw_f|BMW M3 (F80 generation)|$38,000">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:src="@drawable/car_bmw_f"
                android:scaleType="centerCrop"
                android:contentDescription="BMW M3 F80" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BMW M3 (F80 generation)"
                android:textSize="16sp"
                android:layout_marginTop="8dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="$38,000"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="#000000"/>
        </LinearLayout>

        <!-- Car 2 -->
        <LinearLayout
            android:id="@+id/mercedesCla"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:orientation="vertical"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:tag="mercedesCla|car_mercedes_cla|Mercedes-Benz CLA-Class (Second Generation)|$46,400">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:src="@drawable/car_mercedes_cla"
                android:scaleType="centerCrop"
                android:contentDescription="Mercedes CLA" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mercedes-Benz CLA-Class (Second Generation)"
                android:textSize="16sp"
                android:layout_marginTop="8dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="$46,400"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="#000000"/>
        </LinearLayout>

        <!-- Car 3 -->
        <LinearLayout
            android:id="@+id/porsche911"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:orientation="vertical"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:tag="porsche911|car_porsche_gt|Porsche 911 GT3 RS (991.1 Generation)|$189,000">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:src="@drawable/car_porsche_gt"
                android:scaleType="centerCrop"
                android:contentDescription="Porsche 911 GT3" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Porsche 911 GT3 RS (991.1 Generation)"
                android:textSize="16sp"
                android:layout_marginTop="8dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="$189,000"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="#000000"/>
        </LinearLayout>

        <!-- Car 4 -->
        <LinearLayout
            android:id="@+id/ferari488"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:orientation="vertical"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:tag="ferari488|car_ferrari_spider|Ferrari 488 Spider|$260,000">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:src="@drawable/car_ferrari_spider"
                android:scaleType="centerCrop"
                android:contentDescription="Ferrari 488 Spider" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ferrari 488 Spider"
                android:textSize="16sp"
                android:layout_marginTop="8dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="$260,000"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="#000000"/>
        </LinearLayout>

    </GridLayout>


    <FrameLayout
        android:id="@+id/fragment_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:elevation="10dp" />
</androidx.constraintlayout.widget.ConstraintLayout>
